# {{ name }} task runner. `just` on its own lists everything.
#
# The toolchain (node, {% if pm != "npm" %}{{ pm }}, {% endif %}just and the audit tools) is pinned in mise.toml — run `mise install` once.
# The gate's recipes are in plinth.just, which `plinth init` rewrites. The project's own recipes go
# here, and one named like a recipe there replaces it.

set allow-duplicate-recipes

import 'plinth.just'

# List available recipes
default:
    @just --list --unsorted

# One-time setup: commit guard
setup:
    git config core.hooksPath .githooks
